# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test-mode keys during development; never commit real values)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Transactional email via Brevo SMTP (order confirmations, receipts, refunds, reminders).
# Credentials from Brevo -> SMTP & API -> SMTP tab. Emails are skipped (logged) when unset.
# LOGIN is the "Login" value on that tab (looks like 12ab34001@smtp-brevo.com) — NOT the
# smtp-relay.brevo.com host, which the app already sets itself. A wrong login fails with
# "535 5.7.8 Authentication failed".
BREVO_SMTP_LOGIN=12ab34001@smtp-brevo.com
# The SMTP key from the same tab (starts with xsmtpsib-), not a v3 API key (xkeysib-).
BREVO_SMTP_KEY=xsmtpsib-xxx
# Must be a verified Brevo sender (Senders & Domains -> Senders), NOT the SMTP login.
EMAIL_FROM="Body Inc <ithelp@bodyinc.com>"

# Absolute base URL of the patient portal — used for links inside reminder emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/reminders (Vercel Cron sends it as "Authorization: Bearer <value>").
CRON_SECRET=6d8d3c7b9e4a2f1c5b8e9a1d7f3c6b4e0a9f2d1c7e8b5a3f9d6e1c4b8a2f7d5

# Ops inbox for refund requests and failed payment alerts (optional; skipped when unset).
ADMIN_NOTIFY_EMAIL=ithelp@bodyinc.com
# Admin/provider portal base URL for deep links in provider case-assigned emails (optional).
ADMIN_APP_URL=https://admin.bodyinc.com

