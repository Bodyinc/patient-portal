# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test-mode keys during development; never commit real values)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Transactional email via Brevo SMTP (receipts, refunds, reminders).
# Credentials from Brevo -> SMTP & API -> SMTP tab. Emails are skipped (logged) when unset.
BREVO_SMTP_LOGIN=xxx@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-xxx
# Must be a verified Brevo sender (Senders & Domains -> Senders), NOT the SMTP login.
EMAIL_FROM="Body Inc <you@yourdomain.com>"

# Absolute base URL of the patient portal — used for links inside reminder emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/reminders (Vercel Cron sends it as "Authorization: Bearer <value>").
CRON_SECRET=
